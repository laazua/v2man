# ===================================================================
# v2man 环境变量配置
# 复制此文件为 .env 并根据实际环境修改
# cp .env.example .env
# ===================================================================

# --- Django 核心 ---
SECRET_KEY=                                   # 必填！Django 密钥，用于加密会话/CSRF/token。
                                              # 生成方式：python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DEBUG=False                                   # 调试模式，生产环境务必设为 False
ALLOWED_HOSTS=*                               # 允许访问的域名/IP，逗号分隔。生产环境应设为具体域名

# --- 数据库 ---
# SQLite（开发用，默认）
DATABASE_URL=sqlite:///db.sqlite3
# PostgreSQL（生产用，取消注释下一行并注释上行）
# DATABASE_URL=postgres://${DB_USER:-v2man}:${DB_PASSWORD}@db:5432/v2man

# --- 静态文件 ---
STATIC_ROOT=staticfiles                       # collectstatic 输出目录

# --- 前端地址 ---
FRONTEND_URL=                                 # 前端域名，用于密码重置等邮件中的跳转链接。
                                              # 开发环境：http://localhost:5173
                                              # 生产环境：https://你的域名
                                              # 留空则自动从请求的 Host 头推断（不推荐生产使用）

# --- 跨域 ---
CORS_ALLOWED_ORIGINS=                         # 允许跨域的前端地址，逗号分隔。
                                              # 开发环境：http://localhost:5173
                                              # 生产环境：https://你的域名

# --- JWT ---
JWT_ACCESS_MINUTES=60                         # Access Token 有效期（分钟）
JWT_REFRESH_DAYS=30                           # Refresh Token 有效期（天）

# --- 邮件配置 ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
                                              # 邮件后端。console 输出到终端（开发用）
                                              # 生产环境改为：django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=                                   # SMTP 服务器地址，如 smtp.gmail.com
EMAIL_PORT=587                                # SMTP 端口
EMAIL_HOST_USER=                              # SMTP 用户名
EMAIL_HOST_PASSWORD=                          # SMTP 密码
EMAIL_USE_TLS=True                            # 是否启用 TLS
DEFAULT_FROM_EMAIL=noreply@v2man.local        # 发件人地址

# --- QQ邮件配置示例 ---
# EMAIL_HOST=smtp.qq.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=QQ账号@qq.com
# EMAIL_HOST_PASSWORD=QQ邮箱授权码(登录QQ邮箱开通获取)
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=QQ账号@qq.com

# --- 跨域安全 ---
CSRF_TRUSTED_ORIGINS=                        # CSRF 信任来源，逗号分隔。与 CORS_ALLOWED_ORIGINS 保持一致
                                              # 开发环境：http://localhost:5173
                                              # 生产环境：https://你的域名
